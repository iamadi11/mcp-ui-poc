# Local only: copy this file to `.env.local` (gitignored). The server loads
# `.env.local` then `.env` when VERCEL is unset. Prefer omitting paid keys on
# Vercel — visitors BYOK in Settings, or point at open endpoints below.

# ── Open defaults (recommended) ──────────────────────────────────────────
# Laya DecisionAdapter — run services/laya-sidecar then:
# LAYA_BASE_URL=http://127.0.0.1:8091
# LAYA_API_KEY=
# DECISION_PROVIDER=auto
# Local ONNX (fat Node host only; not Vercel):
# LAYA_MODE=onnx
# LAYA_ENABLED=1
# LAYA_MODEL_DIR=./onnx

# OpenAI-compatible LLM (Ollama / Groq / OpenRouter / vLLM / LM Studio):
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.3
# LLM_PROVIDER=openai

# ── Paid / BYOK (optional) ───────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
# LLM_PROVIDER=anthropic

# Jev (TypeSafe System One) — used when Laya is not configured
# TYPESAFE_API_KEY=apikey...
# TYPESAFE_MODEL=jev-1.13.0
# JEV_MIN_CONFIDENCE=0.5

# Decision store. Local Redis via REDIS_URL, or Upstash REST in production.
# REDIS_URL=redis://127.0.0.1:6379
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# MCP_DESIGN_SYSTEM=shadcn

# Optional: Google Maps JavaScript API for catalog map workspaces (Drawing library).
# Enable Maps JavaScript API in Google Cloud. Restrict the browser key by HTTP referrer.
# Published embeds use this env key. Studio can also paste a key in Settings (BYOK header).
# GOOGLE_MAPS_API_KEY=

# Allow fetching localhost/private-network endpoints (off by default — SSRF guard)
# MCP_ALLOW_PRIVATE_ENDPOINTS=1

# Endpoint fetch limits
# MCP_MAX_FETCH_BYTES=2097152
# MCP_FETCH_TIMEOUT_MS=15000
# MCP_MAX_REDIRECTS=5

# LLM planner call timeout (AbortSignal; default 30000)
# MCP_LLM_TIMEOUT_MS=30000

# MCP_MAX_HTML_BYTES=786432
# MCP_RATE_LIMIT_GENERATE_PER_MIN=45
# MCP_RATE_LIMIT_FEEDBACK_PER_MIN=60

# MongoDB. Local: mongodb://127.0.0.1:27017/mcp_ui  Production: Atlas mongodb+srv://
# MONGODB_URI=mongodb://127.0.0.1:27017/mcp_ui
# MONGODB_DB=mcp_ui

# GitHub OAuth App (owner publish/edit). Callback: {PUBLIC_ORIGIN}/api/auth/github/callback
# PUBLIC_ORIGIN=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SESSION_SECRET=
